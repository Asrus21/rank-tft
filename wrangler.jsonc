{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Precisa ser igual ao nome do Worker no painel da Cloudflare e ao
  // "service" do binding RANK_TFT no gateway (repositório elorank-games).
  "name": "rank-tft",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Página e arquivos estáticos. O que não for arquivo (API) cai no Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Endereço de teste: rank-tft.<sua-conta>.workers.dev. O público acessa por
  // elorank-games.com.br/rank-tft (o gateway repassa para cá).
  "workers_dev": true,

  "observability": { "enabled": true }
}
